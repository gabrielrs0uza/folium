{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Somente a janela local do Folium pode salvar seu currículo e abrir diálogos de arquivos.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize",
    "allow-load-curriculum", "allow-save-curriculum",
    "allow-document-state", "allow-create-document", "allow-rename-document",
    "allow-delete-document", "allow-switch-document",
    "allow-export-file", "allow-import-backup", "allow-print-curriculum"
  ]
}
