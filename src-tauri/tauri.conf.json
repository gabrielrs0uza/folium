{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folium",
  "version": "0.1.0",
  "identifier": "com.folium.curriculum",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Folium — Meu currículo",
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": {"x": 19, "y": 26},
      "width": 1360,
      "height": 940,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "visible": false,
      "backgroundColor": "#fafafa",
      "dragDropEnabled": false,
      "devtools": false
    }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Seu currículo, do seu jeito.",
    "longDescription": "Editor de currículo offline, com salvamento local, backups e exportação em PDF.",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion": "11.0", "signingIdentity": "-"},
    "windows": {
      "webviewInstallMode": {"type": "embedBootstrapper"},
      "nsis": {"installMode": "currentUser", "languages": ["PortugueseBR"], "displayLanguageSelector": false}
    }
  }
}
